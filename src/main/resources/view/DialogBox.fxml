<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308" spacing="8.0"
         type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="300.0" minHeight="-Infinity" styleClass="message-bubble"
               wrapText="true" />
        <ImageView fx:id="avatar"
                   fitHeight="50.0"
                   fitWidth="50.0"
                   preserveRatio="true"
                   smooth="true"
                   styleClass="avatar" />
    </children>
    <padding>
        <Insets bottom="7.0" left="5.0" right="5.0" top="7.0" />
    </padding>
</fx:root>
